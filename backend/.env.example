# ==============================================
# Comic Social Platform - Backend Configuration
# ==============================================
# Copy this file to .env and fill in your actual values

# ==============================================
# Server Configuration
# ==============================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================================
# MongoDB Configuration
# ==============================================
# Local MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/comic-social-platform

# MongoDB Atlas connection string (alternative)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/comic-social-platform?retryWrites=true&w=majority

# ==============================================
# Auth0 Configuration
# ==============================================
# Get these from your Auth0 dashboard: https://manage.auth0.com/
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=your-api-identifier

# Example:
# AUTH0_DOMAIN=dev-abc123.us.auth0.com
# AUTH0_AUDIENCE=https://api.comic-platform.com

# ==============================================
# AI Service Configuration
# ==============================================

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================
# Cloudinary Configuration
# ==============================================
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================
# CORS Configuration
# ==============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================
# Rate Limiting (Optional)
# ==============================================
# Maximum requests per window
RATE_LIMIT_MAX=100
# Time window in minutes
RATE_LIMIT_WINDOW=15

# ==============================================
# Logging (Optional)
# ==============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ==============================================
# Notes
# ==============================================
# 1. Never commit the .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different values for development and production
# 4. Ensure MongoDB is running before starting the server
# 5. Configure Auth0 callback URLs to match your domains
