# ==============================================
# Comic Social Platform - Frontend Configuration
# ==============================================
# Copy this file to .env and fill in your actual values

# ==============================================
# Auth0 Configuration
# ==============================================
# Get these from your Auth0 dashboard: https://manage.auth0.com/

# Your Auth0 domain (e.g., dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Your Auth0 application client ID
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Your Auth0 API audience/identifier
VITE_AUTH0_AUDIENCE=your_api_identifier

# Redirect URI after authentication (must match Auth0 settings)
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# OAuth scopes to request
VITE_AUTH0_SCOPE=openid profile email

# ==============================================
# API Configuration
# ==============================================
# Backend API base URL
VITE_API_BASE=http://localhost:3000

# Alternative for production:
# VITE_API_BASE_URL=https://api.your-domain.com

# ==============================================
# Feature Flags (Optional)
# ==============================================
# Enable/disable features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# ==============================================
# Notes
# ==============================================
# 1. Never commit the .env file to version control
# 2. All Vite env variables must be prefixed with VITE_
# 3. Restart the dev server after changing env variables
# 4. Configure Auth0 application settings:
#    - Allowed Callback URLs: http://localhost:5173
#    - Allowed Logout URLs: http://localhost:5173
#    - Allowed Web Origins: http://localhost:5173
# 5. For production, update URLs to match your domain
